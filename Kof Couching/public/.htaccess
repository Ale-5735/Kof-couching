<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # Permitir peticiones directas a la API PHP sin reescritura
  RewriteRule ^api/ - [L]

  # Si el archivo o directorio existe, entregarlo directamente
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Todas las demás rutas van a React Single Page Application
  RewriteRule ^ index.html [L]
</IfModule>

# Seguridad: Evitar exploración de carpetas
Options -Indexes

# Compresión para rendimiento óptimo
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json
</IfModule>

